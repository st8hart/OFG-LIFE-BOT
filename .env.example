# ============================
# VIVID LIFE BOT - CONFIG
# ============================
# Copy this file to .env and fill in your values

# Get from: https://discord.com/developers/applications
# Your Bot Token (keep this SECRET - never share it)
DISCORD_TOKEN=your_bot_token_here

# Your Application/Client ID
CLIENT_ID=your_client_id_here

# The Guild (Server) ID where you want to deploy commands
GUILD_ID=your_guild_id_here

# Channel ID where sales announcements get posted
SALES_CHANNEL_ID=your_sales_channel_id_here

# Channel ID where leaderboards get posted (can be same as above)
LEADERBOARD_CHANNEL_ID=your_leaderboard_channel_id_here

# Monthly team goal in dollars (no commas)
MONTHLY_GOAL=200000

# ── The OFG Hub's door ────────────────────────────────────────────────────────
# Shared secret for POST /hub/sale-announce. A sale logged in the hub is handed
# here by id so it gets the SAME announcements as /sale — Hat Trick, whale
# alert, records, all of it. Must be the identical long random string set as
# HUB_SHARED_SECRET on the OFG-HUB service in Railway; if the two disagree the
# bot answers 401 and the hub quietly posts its plainer embed instead.
# Leave it unset and the door stays shut (503) — nothing breaks, hub sales just
# don't get the full reaction.
HUB_SHARED_SECRET=a_long_random_string_the_same_on_both_services

# Port that door listens on. Railway sets this for you; only set it locally.
PORT=3000
